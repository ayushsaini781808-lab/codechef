//Most Expensive Items

#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
   int t;
   cin>>t;
   while(t--){
       int n,k;
       cin>>n>>k;
       int sum=0;
       int a[n];
       for(int i=0;i<n;i++){
           cin>>a[i];
       }
       sort(a,a+n);
       for(int i=n-1;i>=n-k;i--){
           sum+=a[i];
       }
       cout<<sum<<endl;
   }
   return 0;
}
