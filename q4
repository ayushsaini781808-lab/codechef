//Best of Two
#include <iostream>
using namespace std;

int main() {
    int T;
    cin >> T;
 while (T--) {
        int a1, a2, a3, b1, b2, b3;
        cin>>a1>>a2>>a3>>b1>>b2>>b3; 
        int aliceScore=a1+a2+a3-min(a1,min(a2,a3));
        int bobScore=b1+b2+b3-min(b1,min(b2,b3));
        
        if (aliceScore > bobScore) {
            cout<<"Alice"<<endl;
        } 
        else if (bobScore > aliceScore) {
            cout<<"Bob"<<endl;
        }
        else {
            cout<<"Tie"<<endl;
        }
    }

    return 0;
}